# Required in any non-throwaway environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Optional overrides (sane defaults are used if omitted)
# DATABASE_URL=sqlite:///./ad_engine.db
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# CORS_ORIGINS=["http://localhost:3000"]
# LOG_LEVEL=INFO

# Facebook / Meta Marketing API
FB_ACCESS_TOKEN=your_access_token
FB_AD_ACCOUNT_ID=act_your_ad_account_id
FB_APP_ID=your_app_id
FB_APP_SECRET=your_app_secret

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_login_customer_id
GOOGLE_ADS_CUSTOMER_ID=your_customer_id

# Optional: AI-enhanced insights. If unset, the app works exactly as before
# and only the rule-based insights are shown - no functionality is lost.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
